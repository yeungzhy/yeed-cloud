<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- XML   负责 日志格式/归档策略 -->
    <!-- Nacos 负责 日志级别控制 -->

    <!-- 指定日志输出路径 -->
    <springProperty scope="context" name="logging.path" source="logging.file.path"/>

    <!-- 彩色日志依赖的渲染类 -->
    <conversionRule conversionWord="clr" class="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wex" class="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>
    <conversionRule conversionWord="wEx" class="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>

    <!-- 按照激活环境确定是否加载敏感日志数据转换器 -->
    <springProfile name="test,prod">
        <conversionRule conversionWord="seda" class="com.yeungzhy.yeed.common.core.support.SensitiveDataLogConverter"/>
    </springProfile>
    <springProfile name="dev">
        <conversionRule conversionWord="seda" class="ch.qos.logback.classic.pattern.MessageConverter"/>
    </springProfile>

    <!-- 日志格式，引入彩色日志转换器、敏感数据转换器【%seda】，一般情况下这里用的是【%m】【%msg】，即日志原文 -->
    <property name="CONSOLE_LOG_PATTERN" value="${CONSOLE_LOG_PATTERN:-%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %seda%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}"/>
    <property name="FILE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %seda%n"/>
    <property name="CONVERTER_ERROR_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- 控制台日志：无需任何 Filter，完全遵从 Root 级别 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 全量日志文件：不设 Filter，完全遵从 Root 级别 -->
    <appender name="ALL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${logging.path}/all.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${logging.path}/history/all-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <maxFileSize>100MB</maxFileSize>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 错误日志文件 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${logging.path}/error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${logging.path}/history/error-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <maxFileSize>100MB</maxFileSize>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 脱敏组件异常输出的 控制台 Appender -->
    <appender name="CONVERTER_ERROR_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONVERTER_ERROR_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 脱敏组件异常输出的 文件 Appender -->
    <appender name="CONVERTER_ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${logging.path}/converter-error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${logging.path}/history/converter-error-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <maxFileSize>10MB</maxFileSize>
        </rollingPolicy>
        <encoder>
            <pattern>${CONVERTER_ERROR_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
      配置脱敏组件专用的 Logger
      name: 必须精确匹配 LoggerFactory.getLogger(SensitiveDataLogConverter.class) 解析出的全限定名
      level: ERROR（只记录异常）
      additivity="false": 关键！不让日志向上传递给 root，从而避开 %seda（防止递归脱敏）
    -->
    <logger name="com.yeungzhy.yeed.common.core.support.SensitiveDataLogConverter" level="ERROR" additivity="false">
        <appender-ref ref="CONVERTER_ERROR_CONSOLE" />
        <appender-ref ref="CONVERTER_ERROR_FILE" />
    </logger>

    <!-- 定义异步 Appender，引用 ALL_FILE -->
    <appender name="ASYNC_ALL" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <!-- 当队列彻剩余容量为 0 时才丢弃级别日志 DEBUG、INFO 和 TRACE, WARN 和 ERROR 永远不会被丢弃 -->
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="ALL_FILE"/>
    </appender>

    <!-- 定义异步 Appender，引用 ERROR_FILE -->
    <appender name="ASYNC_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="ERROR_FILE"/>
    </appender>

    <!-- 不写死 root level，完全由外部配置（YAML/Nacos）驱动 -->
    <root>
        <appender-ref ref="CONSOLE"/>
        <!-- <appender-ref ref="ALL_FILE"/> -->
        <!-- <appender-ref ref="ERROR_FILE"/> -->
        <appender-ref ref="ASYNC_ALL"/>
        <appender-ref ref="ASYNC_ERROR"/>
    </root>

</configuration>
