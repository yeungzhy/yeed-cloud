<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yeungzhy</groupId>
        <artifactId>yeed-common</artifactId>
        <version>20260501</version>
    </parent>

    <artifactId>yeed-common-security</artifactId>
    <packaging>jar</packaging>


    <dependencies>
        <dependency>
            <groupId>com.yeungzhy</groupId>
            <artifactId>yeed-common-core</artifactId>
            <version>20260501</version>
        </dependency>

        <!--
            Sa-Token 三件套（栈无关部分）：
            业务模块引入本模块后，只需再补一个对应栈的 starter 即可拥有完整 Sa-Token 能力：
              - servlet 模块（admin/auth）：sa-token-spring-boot3-starter
              - reactive 模块（gateway）：sa-token-reactor-spring-boot3-starter
        -->
        <!-- Sa-Token 核心 API：StpUtil / SaSession 等 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-core</artifactId>
        </dependency>
        <!-- Sa-Token JWT 扩展：token 生成与校验 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-jwt</artifactId>
        </dependency>
        <!-- Sa-Token Redis 存储：会话持久化，传递 spring-boot-starter-data-redis -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-template</artifactId>
        </dependency>
        <!--
            commons-pool2：Lettuce 连接池实现。
            sa-token-redis-template 传递 spring-boot-starter-data-redis，连接池配置
            （spring.data.redis.lettuce.pool.*）需该类库在 classpath 才生效。
            admin 等模块不引 common-cache，Redis 连接完全由本模块传递提供，故自带连接池能力。
            与是否使用 Sa-Token 无关：若换 Spring Security 且会话仍存 Redis，连接池依旧需要。
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- SaTokenLoginUserContext 直接使用 ObjectMapper 做类型转换，compile 保证自包含 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

    </dependencies>


</project>
