<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yeungzhy</groupId>
        <artifactId>yeed-common</artifactId>
        <version>20260501</version>
    </parent>

    <artifactId>yeed-common-web</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.yeungzhy</groupId>
            <artifactId>yeed-common-core</artifactId>
            <version>20260501</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Servlet API：spring-web 中的多个 Web 异常类（如 HttpRequestMethodNotSupportedException、
             MissingServletRequestParameterException、HttpMediaTypeNotSupportedException）直接或间接继承自
             jakarta.servlet.ServletException。GlobalExceptionHandler 通过 @ExceptionHandler 捕获这些异常时，
             编译器需要解析其完整继承链（含 ServletException），而 spring-web 将 jakarta.servlet-api 声明为
             provided 不向下传递，故此显式声明以保证 yeed-common 编译通过 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring WebMVC：GlobalExceptionHandler 通过 @ExceptionHandler 捕获的多个 Web 异常类
             （如 MissingServletRequestParameterException、NoResourceFoundException）物理位于
             spring-webmvc 模块（尽管包名为 org.springframework.web.bind / web.servlet.resource）。
             spring-webmvc 由 spring-boot-starter-web 引入，但 yeed-common 不依赖 starter-web，
             此处 provided scope 保证编译可用且不传递给下游（如 reactive Gateway 模块） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Apache HttpClient 5：RestClient 与 OpenFeign 共用的底层高性能 HTTP 客户端（连接池/超时/重试） -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>

        <!-- FastJson -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <scope>provided</scope>
        </dependency>


    </dependencies>


</project>
