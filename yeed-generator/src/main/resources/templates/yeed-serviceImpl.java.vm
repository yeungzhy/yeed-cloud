package ${package.ServiceImpl};

import com.baomidou.mybatisplus.core.conditions.query.LambdaQueryWrapper;
import com.baomidou.mybatisplus.core.toolkit.Wrappers;
import ${dtoPackage}.${entity}DTO;
import ${dtoPackage}.${entity}PageDTO;
import ${entityFullPackage}.${entity};
import ${package.Mapper}.${table.mapperName};
import ${servicePackage}.${entity}Convert;
#if(${generateService})
import ${package.Service}.${table.serviceName};
#end
import ${sortsPackage}.${entity}Sorts;
import ${voPackage}.${entity}VO;
import com.yeungzhy.yeed.common.core.exception.BizAssert;
import com.yeungzhy.yeed.common.core.result.PageResult;
import jakarta.annotation.Resource;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.util.Collection;

/**
 * $!{table.comment} 服务实现类
 *
 * @author ${author}
 * @since ${date}
 */
@Slf4j
@Service
public class ${table.serviceImplName}#if(${generateService}) implements ${table.serviceName}#end {

    @Resource
    private ${entity}Sorts ${table.entityPath}Sorts;
    @Resource
    private ${table.mapperName} ${table.entityPath}Mapper;
    @Resource
    private ${entity}Convert ${table.entityPath}Convert;


    @Override
    public Long save(${entity}DTO dto) {
        // DTO -> Entity：同名字段由 MapStruct 自动映射
        ${entity} entity = ${table.entityPath}Convert.toEntity(dto);
        ${table.entityPath}Mapper.insert(entity);
        return entity.getId();
    }


    @Override
    public void update(${entity}DTO dto) {
        BizAssert.notNull(dto.getId(), "ID 不能为空");
        // DTO -> Entity：id 与业务字段均自动映射
        ${entity} entity = ${table.entityPath}Convert.toEntity(dto);
        ${table.entityPath}Mapper.updateById(entity);
    }


    @Override
    public ${entity}VO detail(Long id) {
        ${entity} entity = ${table.entityPath}Mapper.selectById(id);
        BizAssert.notNull(entity, "记录不存在");
        // Entity -> VO：同名字段由 MapStruct 自动映射
        return ${table.entityPath}Convert.toVO(entity);
    }


    @Override
    public PageResult<${entity}VO> page(${entity}PageDTO dto) {
        // TODO 构建查询条件
        LambdaQueryWrapper<${entity}> lambdaQuery = Wrappers.<${entity}>lambdaQuery();

        // 应用排序：先单字段 → 再多字段(顺序敏感)；默认降序；白名单外字段静默忽略
        ${table.entityPath}Sorts.applyAll(lambdaQuery, dto.getOrderField(), dto.getIsAsc(), dto.getOrders());

        return ${table.entityPath}Mapper.selectPageResult(dto, lambdaQuery, ${table.entityPath}Convert::toVO);
    }


    @Override
    public void delete(Long id) {
        BizAssert.notNull(id, "ID 不能为空");
        ${table.entityPath}Mapper.deleteByIdAutoFill(id);
    }


    @Override
    public void delete(Collection<Long> ids) {
        BizAssert.notEmpty(ids, "ID 集合不能为空");
        // 批量逻辑删除：空集合不触库，超量自动分片，删除人自动填充
        ${table.entityPath}Mapper.deleteByIdsAutoFill(ids);
    }


    @Override
    public PageResult<${entity}VO> pageWithDeleted(${entity}PageDTO dto) {
        // TODO 构建查询条件
        LambdaQueryWrapper<${entity}> lambdaQuery = Wrappers.<${entity}>lambdaQuery();

        // 应用排序：先单字段 → 再多字段(顺序敏感)；默认降序；白名单外字段静默忽略
        ${table.entityPath}Sorts.applyAll(lambdaQuery, dto.getOrderField(), dto.getIsAsc(), dto.getOrders());

        // 回收站分页：查询包含已逻辑删除的数据（与 page 的区别是不携带条件 delete_time = 0）
        return ${table.entityPath}Mapper.selectPageResultWithDeleted(dto, lambdaQuery, ${table.entityPath}Convert::toVO);
    }


    @Override
    public void restoreById(Long id) {
        BizAssert.notNull(id, "ID 不能为空");
        // 恢复已逻辑删除的数据；对未删除数据执行返回 0（天然幂等）
        BizAssert.isTrue(${table.entityPath}Mapper.restoreById(id) > 0, "记录不存在或未删除");
    }


    @Override
    public void physicalDeleteById(Long id) {
        BizAssert.notNull(id, "ID 不能为空");
        // 物理删除（真 DELETE）：不可恢复，仅用于"回收站彻底删除"等场景
        ${table.entityPath}Mapper.physicalDeleteById(id);
    }


}
