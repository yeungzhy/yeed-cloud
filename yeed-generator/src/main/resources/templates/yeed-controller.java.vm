package ${package.Controller};

import ${dtoPackage}.${entity}DTO;
import ${dtoPackage}.${entity}PageDTO;
import ${package.Service}.${table.serviceName};
import ${voPackage}.${entity}VO;
import com.yeungzhy.yeed.common.request.IdRequest;
import com.yeungzhy.yeed.common.result.ApiResult;
import com.yeungzhy.yeed.common.result.PageResult;
import jakarta.annotation.Resource;
import jakarta.validation.Valid;
import lombok.extern.slf4j.Slf4j;
import org.springframework.validation.annotation.Validated;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

/**
 * $!{table.comment} 前端控制器
 *
 * @author ${author}
 * @since ${date}
 */
@Slf4j
@Validated
@RestController
@RequestMapping("#if(${package.ModuleName})/${package.ModuleName}#end/#if(${controllerMappingHyphenStyle})${controllerMappingHyphen}#else${table.entityPath}#end")
public class ${table.controllerName} {

    @Resource
    private ${table.serviceName} ${table.entityPath}Service;


    /**
     * 新增
     *
     * @param dto 入参
     * @return 新增记录的主键 ID
     * @author ${author}
     * @since ${date}
     */
    @PostMapping("/save")
    public ApiResult<Long> save(@Valid @RequestBody ${entity}DTO dto) {
        return ApiResult.ok(${table.entityPath}Service.save(dto));
    }


    /**
     * 详情
     *
     * @param id 主键 ID
     * @return 详情数据
     * @author ${author}
     * @since ${date}
     */
    @PostMapping("/detail")
    public ApiResult<${entity}VO> detail(@Valid @RequestBody IdRequest id) {
        return ApiResult.ok(${table.entityPath}Service.detail(id.getId()));
    }


    /**
     * 更新
     *
     * @param dto 入参
     * @return 操作结果
     * @author ${author}
     * @since ${date}
     */
    @PostMapping("/update")
    public ApiResult<Boolean> update(@Valid @RequestBody ${entity}DTO dto) {
        ${table.entityPath}Service.update(dto);
        return ApiResult.ok();
    }


    /**
     * 分页查询
     *
     * @param dto 分页查询入参
     * @return 分页结果
     * @author ${author}
     * @since ${date}
     */
    @PostMapping("/page")
    public ApiResult<PageResult<${entity}VO>> page(@Valid @RequestBody ${entity}PageDTO dto) {
        return ApiResult.ok(${table.entityPath}Service.page(dto));
    }


    /**
     * 删除（逻辑删除）
     *
     * @param id 主键 ID
     * @return 操作结果
     * @author ${author}
     * @since ${date}
     */
    @PostMapping("/delete")
    public ApiResult<Boolean> delete(@Valid @RequestBody IdRequest id) {
        ${table.entityPath}Service.delete(id.getId());
        return ApiResult.ok();
    }


}
