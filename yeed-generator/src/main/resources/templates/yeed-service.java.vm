package ${package.Service};

import ${dtoPackage}.${entity}DTO;
import ${dtoPackage}.${entity}PageDTO;
import ${entityFullPackage}.${entity};
import ${voPackage}.${entity}VO;
import com.yeungzhy.yeed.common.core.result.PageResult;

import java.util.Collection;
import java.util.List;

/**
 * $!{table.comment} 服务类
 *
 * @author ${author}
 * @since ${date}
 */
public interface ${table.serviceName} {

    // ==================== 标准写入（CUD） ====================

    /**
     * 新增
     *
     * @param dto 入参
     * @return 新增记录的主键 ID
     * @author ${author}
     * @since ${date}
     */
    Long save(${entity}DTO dto);

    /**
     * 更新
     *
     * @param dto 入参
     * @author ${author}
     * @since ${date}
     */
    void update(${entity}DTO dto);


    // ==================== 标准查询（R） ====================

    /**
     * 详情
     *
     * @param id 主键 ID
     * @return 详情数据
     * @author ${author}
     * @since ${date}
     */
    ${entity}VO detail(Long id);

    /**
     * 分页查询
     *
     * @param dto 分页查询入参
     * @return 分页结果
     * @author ${author}
     * @since ${date}
     */
    PageResult<${entity}VO> page(${entity}PageDTO dto);


    // ==================== 标准删除（逻辑删除） ====================

    /**
     * 删除（逻辑删除）
     *
     * @param id 主键 ID
     * @author ${author}
     * @since ${date}
     */
    void delete(Long id);

    /**
     * 批量删除（逻辑删除）
     *
     * @param ids 主键 ID 集合
     * @author ${author}
     * @since ${date}
     */
    void delete(Collection<Long> ids);


    // ==================== 特殊操作（回收站 & 危险操作） ====================

    /**
     * 分页查询已逻辑删除的数据，如回收站列表
     *
     * @return 分页结果
     * @author ${author}
     * @since ${date}
     */
    PageResult<${entity}VO> pageWithDeleted(${entity}PageDTO dto);

    /**
     * 恢复已逻辑删除的数据
     *
     * @param id 主键 ID
     * @author ${author}
     * @since ${date}
     */
    void restoreById(Long id);

    /**
     * 物理删除（真 DELETE，不可恢复，仅用于"回收站彻底删除"等场景）
     *
     * @param id 主键 ID
     * @author ${author}
     * @since ${date}
     */
    void physicalDeleteById(Long id);

}
