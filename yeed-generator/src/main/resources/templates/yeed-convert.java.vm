package ${servicePackage};

import ${dtoPackage}.${entity}DTO;
import ${entityFullPackage}.${entity};
import ${voPackage}.${entity}VO;
import org.mapstruct.Mapper;

/**
 * $!{table.comment} 对象字段映射器（编译期生成实现类）
 *
 * <p>Entity / DTO / VO 三模型字段同名，由 MapStruct 自动映射，无需手写 setter；
 * 模型字段变更后重新编译即可同步实现类，杜绝手写转换代码与模型字段脱节。
 * <p>声明为 Spring Bean（componentModel = spring），在 Service 实现中直接注入使用。
 *
 * @author ${author}
 * @since ${date}
 */
@Mapper(componentModel = "spring")
public interface ${entity}Convert {

    /** Entity → VO（详情 / 分页列表出参） */
    ${entity}VO toVO(${entity} entity);

    /** DTO → Entity（save / update 入参） */
    ${entity} toEntity(${entity}DTO dto);

}
