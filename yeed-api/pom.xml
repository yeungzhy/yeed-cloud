<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yeungzhy</groupId>
        <artifactId>yeed-cloud</artifactId>
        <version>20260501</version>
    </parent>

    <artifactId>yeed-api</artifactId>
    <packaging>jar</packaging>

    <description>内部契约包：存放 @FeignClient 接口及跨服务共享的入参/出参，仅供内部微服务调用</description>

    <dependencies>
        <dependency>
            <groupId>com.yeungzhy</groupId>
            <artifactId>yeed-common-core</artifactId>
            <version>20260501</version>
        </dependency>

        <!-- OpenFeign：@FeignClient 契约定义（spring-web 注解由其传递引入） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                父 POM pluginManagement 中配置了 repackage goal，但 yeed-api 是纯契约 jar，
                不是 Spring Boot 应用（无 main class），必须跳过 repackage，否则 install 阶段报错
                "Unable to find main class"
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
