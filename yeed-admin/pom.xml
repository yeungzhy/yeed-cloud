<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yeungzhy</groupId>
        <artifactId>yeed-cloud</artifactId>
        <version>20260501</version>
    </parent>

    <artifactId>yeed-admin</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.yeungzhy</groupId>
            <artifactId>yeed-common-core</artifactId>
            <version>20260501</version>
        </dependency>
        <dependency>
            <groupId>com.yeungzhy</groupId>
            <artifactId>yeed-common-data</artifactId>
            <version>20260501</version>
        </dependency>
        <dependency>
            <groupId>com.yeungzhy</groupId>
            <artifactId>yeed-common-web</artifactId>
            <version>20260501</version>
        </dependency>
        <!-- Sa-Token 鉴权：security 模块提供 sa-token-core + jwt + redis-template（栈无关），
             这里只需补 servlet 栈适配 starter -->
        <dependency>
            <groupId>com.yeungzhy</groupId>
            <artifactId>yeed-common-security</artifactId>
            <version>20260501</version>
        </dependency>
        <dependency>
            <groupId>com.yeungzhy</groupId>
            <artifactId>yeed-api</artifactId>
            <version>20260501</version>
        </dependency>

        <!-- Caffeine：本地高性能缓存（W-TinyLFU），IdenticonCacheConfig 和 SysUserController 使用 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Sa-Token Servlet 栈适配（security 模块已提供 core/jwt/redis-template） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>

        <!-- Nacos 配置中心 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- Nacos 服务发现 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- OpenFeign服务调用 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- Feign↔HttpClient5 桥接：使 OpenFeign 底层走 Apache HttpClient 5（hc5 默认启用需此类在 classpath） -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-hc5</artifactId>
        </dependency>
        <!-- 负载均衡器 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- MapStruct：对象字段映射（SysXxxConvert 由生成器生成，实现类编译期自动生成） -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

    </dependencies>


    <build>
        <plugins>
            <!--
                引用父 POM pluginManagement 中的配置。
                因为父 POM 已经配置了 repackage goal 和 excludes，
                这里可以极度简化，甚至只写 groupId + artifactId。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
