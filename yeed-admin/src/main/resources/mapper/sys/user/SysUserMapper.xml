<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yeungzhy.yeed.admin.sys.user.mapper.SysUserMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yeungzhy.yeed.admin.sys.user.entity.SysUser">
        <id column="id" property="id" />
        <result column="username" property="username" />
        <result column="password" property="password" />
        <result column="real_name" property="realName" />
        <result column="employee_no" property="employeeNo" />
        <result column="phone" property="phone" />
        <result column="phone_bidx" property="phoneBidx" />
        <result column="email" property="email" />
        <result column="email_bidx" property="emailBidx" />
        <result column="last_login_time" property="lastLoginTime" />
        <result column="status" property="status" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
        <result column="delete_by" property="deleteBy" />
        <result column="delete_time" property="deleteTime" />
        <result column="version" property="version" />
        <result column="extra" property="extra" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler" />
    </resultMap>


    <!-- 用户启用的角色编码 -->
    <select id="selectRoleCodesByUserId" resultType="java.lang.String">
        SELECT DISTINCT r.role_code
        FROM yeed_sys_user_role ur
                 INNER JOIN yeed_sys_role r ON r.id = ur.role_id
        WHERE ur.user_id = #{userId}
          AND r.delete_time = 0
          AND r.status = 1
    </select>


    <!--
        用户有权限的菜单：一次查询，service 层投影出
          - perms 串（含按钮 type=3，perms 非空去重）
          - 菜单树（仅目录 type=1 / 菜单 type=2，按 parentId 建树）
        列别名转驼峰，确保不依赖 mapUnderscoreToCamelCase 配置
    -->
    <select id="selectMenusByUserId" resultType="com.yeungzhy.yeed.admin.sys.menu.entity.SysMenu">
        SELECT DISTINCT
            m.id        AS id,
            m.parent_id AS parentId,
            m.menu_name AS menuName,
            m.menu_type AS menuType,
            m.path      AS path,
            m.perms     AS perms,
            m.visible   AS visible,
            m.sort      AS sort
        FROM yeed_sys_user_role ur
                 INNER JOIN yeed_sys_role r       ON r.id = ur.role_id AND r.delete_time = 0 AND r.status = 1
                 INNER JOIN yeed_sys_role_menu rm ON rm.role_id = r.id
                 INNER JOIN yeed_sys_menu m       ON m.id = rm.menu_id AND m.delete_time = 0
        WHERE ur.user_id = #{userId}
        ORDER BY m.sort
    </select>




</mapper>
